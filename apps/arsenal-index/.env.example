# Comma-separated allowlist of API keys accepted on X-API-Key.
# Any request presenting one of these skips the HTTP 402 gate.
ARSENAL_API_KEYS=

# --- Stripe -----------------------------------------------------------------
# Use a TEST MODE key while evaluating.
# If STRIPE_SECRET_KEY is absent, every pricing CTA degrades to a
# request-access mailto — never a broken redirect or a dead button.
STRIPE_SECRET_KEY=

# Subscription price IDs from your own Stripe account (price_...).
STRIPE_PRICE_RADAR=
STRIPE_PRICE_INTELLIGENCE=
STRIPE_PRICE_AGENT_API=

# --- x402 -------------------------------------------------------------------
# Per-lookup settlement for agents, peer-to-peer in stablecoins to a wallet via
# Cloudflare's Monetization Gateway. NOT through Stripe, and NOT generally
# available — the gateway is waitlist-only.
#
# Leave unset. While it is off, unverified X-Payment proofs are rejected instead
# of trusted; turning it on before a facilitator can verify settlement would let
# anyone who read the docs walk past the paywall.
X402_ENABLED=

# Absolute origin, used in llms.txt, the MCP descriptor, Stripe redirect URLs,
# and canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:4801
