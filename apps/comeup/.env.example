# Optional. With a key, /plan is composed by claude-sonnet-5 grounded in the
# retrieved archive items. Without one, the deterministic composer runs and the
# result is labelled "template" — the app never breaks for lack of a key.
ANTHROPIC_API_KEY=

# Optional. TEST MODE ONLY for now. With a key, /pricing opens Stripe Checkout.
# Without one, the same buttons capture a waitlist entry instead of 500ing.
STRIPE_SECRET_KEY=

# Absolute origin. Used by llms.txt, the MCP descriptor, canonical URLs and the
# Stripe success/cancel redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:4803
