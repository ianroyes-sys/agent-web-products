# Legible — environment
# Every key here is optional. The app and the audit engine run without any of
# them; features degrade to a documented, clearly-labeled offline mode rather
# than crashing or inventing data.

# Runs the buyer-intent prompt battery against a live model.
# Absent -> `node scripts/battery.mjs` emits DRY RUN output only.
ANTHROPIC_API_KEY=

# Stripe is TEST MODE ONLY today. Absent -> pricing CTAs fall back to
# "Request an invoice" instead of rendering a broken checkout.
STRIPE_SECRET_KEY=

# Absolute origin, used for Stripe redirects and canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:4802
